{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "airbnb-base"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "indent": ["error", 4],
        "max-len": "off",
        "no-console": "off",
        "no-underscore-dangle": "off",
        "no-continue": "off",
        "no-constant-condition": "off",
        "no-await-in-loop": "off",
        "import/extensions": "off"
    }
}
